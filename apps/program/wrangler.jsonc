{
  // Aplicatia pilot. Proprietara datelor ei (`xc-program-*`) — nicio alta aplicatie nu are
  // binding catre baza asta.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xc-program",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,

  "vars": {
    "MEDIU": "dev",
    "ORIGINE_PUBLICA": "https://rubik:8474",
    "DOMENIU_COOKIE": "",
    "EMAIL_SUPERADMIN": "rubikmm@gmail.com"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xc-program-staging",
      "database_id": "8a65cb26-a3c8-4b39-ba98-da0997509bbf",
      "migrations_dir": "../../infrastructure/migrations/program"
    }
  ],

  "services": [
    { "binding": "IDENTITATE", "service": "xc-identity" },
    { "binding": "AUTORIZARE", "service": "xc-authz" },
    { "binding": "AUDIT", "service": "xc-audit" }
  ],

  "queues": {
    "producers": [{ "binding": "EVENIMENTE", "queue": "xc-events-staging" }]
  },

  "triggers": {
    // Trecere periodica prin outbox, pentru randurile ramase nepublicate.
    "crons": ["*/5 * * * *"]
  },

  "env": {
    "staging": {
      "name": "xc-program-staging",
      "vars": {
        "MEDIU": "staging",
        "ORIGINE_PUBLICA": "https://program.staging.sfantul-ilie.ro",
        "DOMENIU_COOKIE": ".staging.sfantul-ilie.ro",
        "EMAIL_SUPERADMIN": "rubikmm@gmail.com",
        "URL_CONT": "https://cont.staging.sfantul-ilie.ro",
        "URL_PROGRAM": "https://program.staging.sfantul-ilie.ro",
        "URL_ADMIN": "https://admin.staging.sfantul-ilie.ro"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "xc-program-staging",
          "database_id": "8a65cb26-a3c8-4b39-ba98-da0997509bbf",
          "migrations_dir": "../../infrastructure/migrations/program"
        }
      ],
      "services": [
        { "binding": "IDENTITATE", "service": "xc-identity-staging" },
        { "binding": "AUTORIZARE", "service": "xc-authz-staging" },
        { "binding": "AUDIT", "service": "xc-audit-staging" }
      ],
      "queues": {
        "producers": [{ "binding": "EVENIMENTE", "queue": "xc-events-staging" }]
      },
      "triggers": { "crons": ["*/5 * * * *"] },
      "routes": [{ "pattern": "program.staging.sfantul-ilie.ro", "custom_domain": true }]
    },
    "production": {
      "name": "xc-program-production",
      "vars": {
        "MEDIU": "production",
        "ORIGINE_PUBLICA": "https://program.sfantul-ilie.ro",
        "DOMENIU_COOKIE": ".sfantul-ilie.ro",
        "EMAIL_SUPERADMIN": "rubikmm@gmail.com",
        "URL_CONT": "https://cont.sfantul-ilie.ro",
        "URL_PROGRAM": "https://program.sfantul-ilie.ro",
        "URL_ADMIN": "https://admin.sfantul-ilie.ro"
      }
      // Ruta de productie (`program.sfantul-ilie.ro`) e a lui A2 pana la cutover-ul explicit.
    }
  }
}
