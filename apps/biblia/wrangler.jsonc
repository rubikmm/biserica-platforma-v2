{
  // Biblia (A10 din V1): Vechiul si Noul Testament, pe carti, capitole si versete.
  // Editia sinodala, preluata de pe bibliaortodoxa.ro — aceleasi 80 de carti ca in V1, copiate
  // in depozit NOU (`xc-biblia-*`), nu refolosite din cel al lui V1.
  //
  // Biblioteca de citit: nu decide nimic, nu anunta nimic si nu tine nimic al altei aplicatii.
  // Ce zi liturgica e si ce pericope are ziua NU se tin aici — le stie calendarul, care vine si
  // cere textul de la noi.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xc-biblia",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  // Data publicarii, pentru randul de versiune din subsol.
  "version_metadata": { "binding": "VERSIUNE" },

  "vars": {
    "MEDIU": "dev",
    "ORIGINE_PUBLICA": "https://rubik:8474",
    "DOMENIU_COOKIE": "",
    "EMAIL_SUPERADMIN": "rubikmm@gmail.com"
  },

  // Depozitul propriu: cartile in JSON, una pe fisier, plus `index.json`.
  "r2_buckets": [
    { "binding": "TEXTE", "bucket_name": "xc-biblia-staging" }
  ],

  "services": [
    { "binding": "IDENTITATE", "service": "xc-identity" }
  ],

  "env": {
    "staging": {
      "name": "xc-biblia-staging",
      "version_metadata": { "binding": "VERSIUNE" },
      "vars": {
        "MEDIU": "staging",
        "ORIGINE_PUBLICA": "https://biblia.staging.sfantul-ilie.ro",
        "DOMENIU_COOKIE": ".staging.sfantul-ilie.ro",
        "EMAIL_SUPERADMIN": "rubikmm@gmail.com",
        "URL_HOME": "https://staging.sfantul-ilie.ro",
        "URL_CONT": "https://cont.staging.sfantul-ilie.ro",
        "URL_CALENDAR": "https://calendar.staging.sfantul-ilie.ro",
        "URL_PROGRAM": "https://program.staging.sfantul-ilie.ro",
        "URL_CURATENIE": "https://curatenie.staging.sfantul-ilie.ro",
        "URL_TIPIC": "https://tipic.staging.sfantul-ilie.ro",
        "URL_BIBLIA": "https://biblia.staging.sfantul-ilie.ro",
        "URL_ADMIN": "https://admin.staging.sfantul-ilie.ro"
      },
      "r2_buckets": [
        { "binding": "TEXTE", "bucket_name": "xc-biblia-staging" }
      ],
      "services": [
        { "binding": "IDENTITATE", "service": "xc-identity-staging" }
      ],
      "routes": [{ "pattern": "biblia.staging.sfantul-ilie.ro", "custom_domain": true }]
    },
    "production": {
      "name": "xc-biblia-production",
      "version_metadata": { "binding": "VERSIUNE" },
      "vars": {
        "MEDIU": "production",
        "ORIGINE_PUBLICA": "https://biblia.sfantul-ilie.ro",
        "DOMENIU_COOKIE": ".sfantul-ilie.ro",
        "EMAIL_SUPERADMIN": "rubikmm@gmail.com",
        "URL_HOME": "https://sfantul-ilie.ro",
        "URL_CONT": "https://cont.sfantul-ilie.ro",
        "URL_CALENDAR": "https://calendar.sfantul-ilie.ro",
        "URL_PROGRAM": "https://program.sfantul-ilie.ro",
        "URL_CURATENIE": "https://curatenie.sfantul-ilie.ro",
        "URL_TIPIC": "https://tipic.sfantul-ilie.ro",
        "URL_BIBLIA": "https://biblia.sfantul-ilie.ro",
        "URL_ADMIN": "https://admin.sfantul-ilie.ro"
      }
      // Ruta de productie (`biblia.sfantul-ilie.ro`) ramane a lui A10 pana la cutover-ul explicit.
    }
  }
}
