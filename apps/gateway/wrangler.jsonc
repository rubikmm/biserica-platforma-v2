{
  // Gateway DOAR pentru preview local.
  //
  // In containerul de test exista un singur port public (Apache -> 8787), dar arhitectura are
  // cate o aplicatie per subdomeniu. Gateway-ul face maparea cale -> aplicatie, ca fluxul sa
  // poata fi incercat cap-coada pe `https://rubik:8474`.
  //
  // In staging si productie NU se foloseste: acolo fiecare aplicatie are domeniul ei si
  // cookie-ul e comun pe domeniul parinte. Vezi docs/adr/0006-gateway-doar-pentru-preview.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xc-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Fara adresa publica *.workers.dev: serviciile se apeleaza DOAR prin Service Binding.
  "workers_dev": false,

  "vars": { "MEDIU": "dev" },

  // PROGRAM si CURATENIE se adauga aici cand aplicatiile lor sunt gata: in `wrangler dev` un
  // binding catre un worker care nu ruleaza in aceeasi sesiune opreste toata sesiunea.
  "services": [
    { "binding": "HOME", "service": "xc-home" },
    { "binding": "CONT", "service": "xc-account" },
    { "binding": "PROGRAM", "service": "xc-program" },
    { "binding": "CALENDAR", "service": "xc-calendar" },
    { "binding": "ADMIN", "service": "xc-admin" }
  ]
}
