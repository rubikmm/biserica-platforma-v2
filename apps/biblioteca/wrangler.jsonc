{
  // Biblioteca (A12 din V1): catalogul bibliotecii de la Hanul Colței — ce carti exista si in
  // cate exemplare. **E un catalog, nu o biblioteca de texte**: cartile se imprumuta fizic, de
  // la pangar. Cele 1349 de titluri, fisele aduse de la librarii si copertile in trei marimi
  // s-au copiat din depozitul V1 in unul NOU (`xc-biblioteca-*`), obiect cu obiect.
  //
  // Doua straturi: catalogul e PUBLIC, iar rezervarile sunt ale omului (D1, numai `user_id`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xc-biblioteca",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": false,
  // Data publicarii, pentru randul de versiune din subsol.
  "version_metadata": { "binding": "VERSIUNE" },

  "vars": {
    "MEDIU": "dev",
    "ORIGINE_PUBLICA": "https://rubik:8474",
    "DOMENIU_COOKIE": "",
    "EMAIL_SUPERADMIN": "rubikmm@gmail.com"
  },

  // Depozitul propriu: catalogul, fisele imbogatite, copertile in trei marimi si PDF-urile.
  "r2_buckets": [{ "binding": "CATALOG", "bucket_name": "xc-biblioteca-staging" }],

  // Cererile de carti si scrisorile compuse. Inauntru numai `user_id`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xc-biblioteca-staging",
      "database_id": "cbf83fce-8c2a-4548-a576-929f460d0bd3"
    }
  ],

  "services": [
    { "binding": "IDENTITATE", "service": "xc-identity" },
    { "binding": "AUTORIZARE", "service": "xc-authz" },
    { "binding": "COMUNICARE", "service": "xc-communication" }
  ],

  // Ceasul de noapte: stinge rezervarile neridicate si da semn celor intarziati.
  // 6:00 UTC = 9:00 la Bucuresti vara, 8:00 iarna — dimineata, nu in miez de noapte.
  "triggers": { "crons": ["0 6 * * *"] },

  "env": {
    "staging": {
      "name": "xc-biblioteca-staging",
      "version_metadata": { "binding": "VERSIUNE" },
      "vars": {
        "MEDIU": "staging",
        "ORIGINE_PUBLICA": "https://biblioteca.staging.sfantul-ilie.ro",
        "DOMENIU_COOKIE": ".staging.sfantul-ilie.ro",
        "EMAIL_SUPERADMIN": "rubikmm@gmail.com",
        "URL_HOME": "https://staging.sfantul-ilie.ro",
        "URL_CONT": "https://cont.staging.sfantul-ilie.ro",
        "URL_CALENDAR": "https://calendar.staging.sfantul-ilie.ro",
        "URL_PROGRAM": "https://program.staging.sfantul-ilie.ro",
        "URL_CURATENIE": "https://curatenie.staging.sfantul-ilie.ro",
        "URL_TIPIC": "https://tipic.staging.sfantul-ilie.ro",
        "URL_BIBLIA": "https://biblia.staging.sfantul-ilie.ro",
        "URL_BIBLIOTECA": "https://biblioteca.staging.sfantul-ilie.ro",
        "URL_BULETIN": "https://buletin.staging.sfantul-ilie.ro",
        "URL_NEWSLETTER": "https://newsletter.staging.sfantul-ilie.ro",
        "URL_LIVE": "https://live.staging.sfantul-ilie.ro",
        "URL_RADIO": "https://radio.staging.sfantul-ilie.ro",
        "URL_ADMIN": "https://admin.staging.sfantul-ilie.ro"
      },
      "r2_buckets": [{ "binding": "CATALOG", "bucket_name": "xc-biblioteca-staging" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "xc-biblioteca-staging",
          "database_id": "cbf83fce-8c2a-4548-a576-929f460d0bd3"
        }
      ],
      "services": [
        { "binding": "IDENTITATE", "service": "xc-identity-staging" },
        { "binding": "AUTORIZARE", "service": "xc-authz-staging" },
        { "binding": "COMUNICARE", "service": "xc-communication-staging" }
      ],
      "triggers": { "crons": ["0 6 * * *"] },
      "routes": [{ "pattern": "biblioteca.staging.sfantul-ilie.ro", "custom_domain": true }]
    },
    "production": {
      "name": "xc-biblioteca-production",
      "version_metadata": { "binding": "VERSIUNE" },
      "vars": {
        "MEDIU": "production",
        "ORIGINE_PUBLICA": "https://biblioteca.sfantul-ilie.ro",
        "DOMENIU_COOKIE": ".sfantul-ilie.ro",
        "EMAIL_SUPERADMIN": "rubikmm@gmail.com",
        "URL_HOME": "https://sfantul-ilie.ro",
        "URL_CONT": "https://cont.sfantul-ilie.ro",
        "URL_CALENDAR": "https://calendar.sfantul-ilie.ro",
        "URL_PROGRAM": "https://program.sfantul-ilie.ro",
        "URL_CURATENIE": "https://curatenie.sfantul-ilie.ro",
        "URL_TIPIC": "https://tipic.sfantul-ilie.ro",
        "URL_BIBLIA": "https://biblia.sfantul-ilie.ro",
        "URL_BIBLIOTECA": "https://biblioteca.sfantul-ilie.ro",
        "URL_BULETIN": "https://buletin.sfantul-ilie.ro",
        "URL_NEWSLETTER": "https://newsletter.sfantul-ilie.ro",
        "URL_LIVE": "https://live.sfantul-ilie.ro",
        "URL_RADIO": "https://radio.sfantul-ilie.ro",
        "URL_ADMIN": "https://admin.sfantul-ilie.ro"
      },
      "r2_buckets": [{ "binding": "CATALOG", "bucket_name": "xc-biblioteca-production" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "xc-biblioteca-production",
          "database_id": "20a9b980-f065-46a3-904d-d42bc097f579"
        }
      ],
      "services": [
        { "binding": "IDENTITATE", "service": "xc-identity-production" },
        { "binding": "AUTORIZARE", "service": "xc-authz-production" },
        { "binding": "COMUNICARE", "service": "xc-communication-production" }
      ],
      "triggers": { "crons": ["0 6 * * *"] }
      // Ruta de productie (`biblioteca.sfantul-ilie.ro`) ramane a lui A12 pana la cutover-ul
      // explicit, cerut de utilizator. Nimic rutat de aici.
    }
  }
}
