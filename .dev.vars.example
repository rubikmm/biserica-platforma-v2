# Copiaza in `.dev.vars` si completeaza DOAR daca activezi livrarea reala de email.
# Fisierul `.dev.vars` e in .gitignore si nu trebuie sa ajunga niciodata in repo.
#
# Cat timp ADAPTOR_EMAIL ramane `sandbox`, nu e nevoie de nimic aici: linkurile de
# confirmare se citesc din interfata (mediul dev) sau din tabela `emails_iesire`.

# ADAPTOR_EMAIL=http
# EMAIL_API_URL=https://api.furnizorul-tau.com/emails
# EMAIL_API_KEY=
# EMAIL_EXPEDITOR=parohia@sfantul-ilie.ro
