{
  // Singurul loc cu reguli, programari si aprobari. NU e un dispecer central: nu contine
  // logica de domeniu a aplicatiilor, doar declanseaza si cere.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xc-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Fara adresa publica *.workers.dev: serviciile se apeleaza DOAR prin Service Binding.
  "workers_dev": false,

  "vars": { "MEDIU": "dev" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xc-automation-staging",
      "database_id": "2b4fc731-8154-46d5-8c3f-b1e984d80ae2",
      "migrations_dir": "../../infrastructure/migrations/automation"
    }
  ],

  "services": [
    { "binding": "COMUNICARE", "service": "xc-communication" },
    { "binding": "AUDIT", "service": "xc-audit" }
  ],

  "env": {
    "staging": {
      "name": "xc-automation-staging",
      "vars": { "MEDIU": "staging" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "xc-automation-staging",
          "database_id": "2b4fc731-8154-46d5-8c3f-b1e984d80ae2",
          "migrations_dir": "../../infrastructure/migrations/automation"
        }
      ],
      "services": [
        { "binding": "COMUNICARE", "service": "xc-communication-staging" },
        { "binding": "AUDIT", "service": "xc-audit-staging" }
      ]
    },
    "production": {
      "name": "xc-automation-production",
      "vars": { "MEDIU": "production" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "xc-automation-production",
          "database_id": "7c4dd88d-f392-45a7-a7a7-0096f9fc2a2c",
          "migrations_dir": "../../infrastructure/migrations/automation"
        }
      ],
      "services": [
        { "binding": "COMUNICARE", "service": "xc-communication-production" },
        { "binding": "AUDIT", "service": "xc-audit-production" }
      ]
    }
  }
}
