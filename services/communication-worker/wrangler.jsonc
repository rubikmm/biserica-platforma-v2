{
  // Singurul serviciu care VA avea vreodata dreptul sa livreze email/WhatsApp.
  // Cat timp LIVRARE_REALA nu e „da", totul merge in sandbox: se inregistreaza, nu pleaca nimic.
  // Cand se porneste, emailul merge prin Cloudflare Email Service (binding `send_email`), ca la identitate.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xc-communication",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Fara adresa publica *.workers.dev: serviciile se apeleaza DOAR prin Service Binding.
  "workers_dev": false,

  "vars": {
    "MEDIU": "dev",
    "LIVRARE_REALA": "nu"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xc-communication-production",
      "database_id": "107b0ae4-8b3b-4b04-b629-2aa53079672f",
      "migrations_dir": "../../infrastructure/migrations/communication"
    }
  ],

  "env": {
    "staging": {
      "name": "xc-communication-staging",
      "vars": {
        "MEDIU": "staging",
        // Ramane „nu" pana la portarea lui A7 (decizie: comunicarea reala abia atunci).
        "LIVRARE_REALA": "nu",
        "POSTA_DE_LA": "no-reply@posta.sfantul-ilie.ro",
        "POSTA_NUME": "Biserica Sfântul Ilie – Hanul Colței"
      },
      "send_email": [{ "name": "POSTA" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "xc-communication-staging",
          "database_id": "2419c275-1134-472a-beba-5404eeabd2b4",
          "migrations_dir": "../../infrastructure/migrations/communication"
        }
      ]
    },
    "production": {
      "name": "xc-communication-production",
      "vars": {
        "MEDIU": "production",
        "LIVRARE_REALA": "nu",
        "POSTA_DE_LA": "no-reply@posta.sfantul-ilie.ro",
        "POSTA_NUME": "Biserica Sfântul Ilie – Hanul Colței"
      },
      "send_email": [{ "name": "POSTA" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "xc-communication-production",
          "database_id": "107b0ae4-8b3b-4b04-b629-2aa53079672f",
          "migrations_dir": "../../infrastructure/migrations/communication"
        }
      ]
    }
  }
}
