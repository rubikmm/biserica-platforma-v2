{
  // Serviciul de identitate. NU e expus public: aplicatiile il apeleaza prin Service Binding.
  //
  // Intrarea e fara parola: email -> link (Cloudflare Email Service) -> sesiune.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xc-identity",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Fara adresa publica *.workers.dev: serviciile se apeleaza DOAR prin Service Binding.
  "workers_dev": false,

  // dev: `wrangler dev` nu trimite prin binding, deci ramanem pe sandbox si linkul apare in pagina.
  "vars": {
    "MEDIU": "dev",
    "ORIGINE_PUBLICA": "https://rubik:8474/cont",
    "DOMENIU_COOKIE": "",
    "EMAIL_SUPERADMIN": "rubikmm@gmail.com",
    "ADAPTOR_EMAIL": "sandbox"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xc-identity-production",
      "database_id": "4d8cd18f-6a5b-4555-b9f0-b3d46bec10ff",
      "migrations_dir": "../../infrastructure/migrations/identity"
    }
  ],

  "services": [
    { "binding": "AUTORIZARE", "service": "xc-authz" },
    { "binding": "AUDIT", "service": "xc-audit" }
  ],

  // Ceasul de noapte: sterge sesiunile si codurile trecute. Ora e cea din V1 (`biserica-cont`),
  // aleasa ca sa cada cand nu e nimeni pe platforma. Nu trimite nimic si nu atinge pe nimeni.
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  "env": {
    "staging": {
      "name": "xc-identity-staging",
      "vars": {
        "MEDIU": "staging",
        "ORIGINE_PUBLICA": "https://cont.staging.sfantul-ilie.ro",
        "DOMENIU_COOKIE": ".staging.sfantul-ilie.ro",
        "EMAIL_SUPERADMIN": "rubikmm@gmail.com",
        // Cloudflare Email Service: expeditorul e pe subdomeniul imbarcat `posta.sfantul-ilie.ro`,
        // NU pe apex — SPF-ul mailului obisnuit al parohiei ramane neatins (decizie V1, 8 sept.).
        "ADAPTOR_EMAIL": "cloudflare",
        "POSTA_DE_LA": "no-reply@posta.sfantul-ilie.ro",
        "POSTA_NUME": "Biserica Sfântul Ilie – Hanul Colței"
      },
      "send_email": [{ "name": "POSTA" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "xc-identity-staging",
          "database_id": "a8ef90fa-28a7-4574-9ee8-ff8d3dc6be45",
          "migrations_dir": "../../infrastructure/migrations/identity"
        }
      ],
      "services": [
        { "binding": "AUTORIZARE", "service": "xc-authz-staging" },
        { "binding": "AUDIT", "service": "xc-audit-staging" }
      ],
      "triggers": { "crons": ["0 3 * * *"] }
    },

    // Pregatit configurational, dar fara resurse create si fara ruta: productia nu se atinge
    // in aceasta faza. Bazele `xc-*-production` se creeaza abia la un cutover explicit.
    "production": {
      "name": "xc-identity-production",
      "vars": {
        "MEDIU": "production",
        "ORIGINE_PUBLICA": "https://cont.sfantul-ilie.ro",
        "DOMENIU_COOKIE": ".sfantul-ilie.ro",
        "EMAIL_SUPERADMIN": "rubikmm@gmail.com",
        "ADAPTOR_EMAIL": "cloudflare",
        "POSTA_DE_LA": "no-reply@posta.sfantul-ilie.ro",
        "POSTA_NUME": "Biserica Sfântul Ilie – Hanul Colței"
      },
      "send_email": [{ "name": "POSTA" }],
      "services": [
        { "binding": "AUTORIZARE", "service": "xc-authz-production" },
        { "binding": "AUDIT", "service": "xc-audit-production" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "xc-identity-production",
          "database_id": "4d8cd18f-6a5b-4555-b9f0-b3d46bec10ff",
          "migrations_dir": "../../infrastructure/migrations/identity"
        }
      ],
      "triggers": { "crons": ["0 3 * * *"] }
    }
  }
}
