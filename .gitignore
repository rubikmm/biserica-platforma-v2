node_modules/
# fara slash: in container `.wrangler` e un symlink catre /data/wrangler, iar `.wrangler/`
# nu prinde symlink-uri — asa ajungea starea locala (inclusiv bazele D1) in repo
.wrangler
dist/
.turbo/
*.log

# Secrete locale — nu ajung niciodata in repo
.dev.vars
.env

# cache-ul local pnpm (aparut la o instalare din container) — nu are ce cauta in repo
.pnpm-store/

# workerul EFEMER al aducerii online → local: il scrie `infrastructure/import/adu-local.mjs` la
# fiecare rulare, din constanta lui. In repo ar fi o a doua copie, care s-ar rataci de prima.
infrastructure/import/adu-local/
